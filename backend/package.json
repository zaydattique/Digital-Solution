{
  "name": "digital-solutions-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx scripts/check-db.ts"
  },
  "dependencies": {
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "postgres": "3.4.9",
    "resend": "6.28.1",
    "zod": "4.6.5",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "22.19.19",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "5.0.1"
  }
}
